# Default: no-payment setup. Stay on Groq Free Plan; do not activate paid billing.
JARVIS_FREE_MODE=true
GROQ_API_KEY=
# Copy to .env. Never commit .env. The following paid integrations are blocked in free mode.
OPENAI_API_KEY=
# Cloud environment secure binding alias (OPENAI_ names may be platform-reserved).
JARVIS_OPENAI_KEY=
OPENAI_MODELS=gpt-4.1-mini,gpt-4.1
# Optional OpenAI-compatible provider (e.g. Groq); HTTPS required.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODELS=llama-3.3-70b-versatile
# Optional paid/free-tier real web search. No search when unset.
BRAVE_SEARCH_API_KEY=
# Default binds localhost via start.ps1. For LAN use a strong password and trusted HTTPS.
JARVIS_PASSWORD=
JARVIS_ALLOWED_HOSTS=localhost,127.0.0.1,::1
JARVIS_SECURE_COOKIE=false
JARVIS_DRY_RUN=true
# Only set false after reviewing all actions and scenes.
HA_URL=
HA_TOKEN=
HA_ENTITIES=
JARVIS_MAX_OUTPUT_TOKENS=1024
JARVIS_DAILY_REQUEST_LIMIT=100
# 0 disables dollar budget; request limit always applies.
JARVIS_DAILY_BUDGET_USD=0
# Set current model-specific prices from your provider in USD per million tokens.
# Format: {"openai/your-model":[INPUT_RATE,OUTPUT_RATE]}; do not assume example rates.
JARVIS_MODEL_RATES_JSON={}
# Optional absolute data directory; contains private conversations and memories.
# JARVIS_DATA_DIR=C:/Users/YourName/JarvisData
