# Copy to .env; never commit or share actual keys.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
WHISPER_MODEL=whisper-large-v3-turbo
JARVIS_LANGUAGE=en
# English male voice, independent of transcription language.
TTS_VOICE=en-GB-RyanNeural
JARVIS_TIMEZONE=Europe/Paris
NOTES_DIR=./data
PROJECTS_DIR=.
AUDIO_INPUT_DEVICE=
CLAP_SENSITIVITY=6
SILENCE_SECONDS=0.9
JARVIS_MAX_OUTPUT_TOKENS=1200
HA_URL=
HA_TOKEN=
HA_ENTITIES=
GOOGLE_CREDENTIALS_FILE=credentials.json
JARVIS_PASSWORD=
JARVIS_ALLOWED_HOSTS=localhost,127.0.0.1,::1
JARVIS_SECURE_COOKIE=false
